#!/usr/bin/env python3
"""Check that README.md's sequence tables render on GitHub, as GitHub renders
them: every table row the generator wrote must come out as a table row with
three cells.

    tools/check-readme-render [README.md]

Needs the GitHub CLI (gh), signed in; it sends the file to GitHub's
Markdown API. A plain Markdown parser is not enough: GitHub ended a table at
a row starting "# |" (a heading) and at one starting "<" (HTML), and the
rows after it rendered as plain text, with no error anywhere.
"""
import json
import pathlib
import re
import subprocess
import sys

path = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else
                    pathlib.Path(__file__).resolve().parent.parent / 'README.md')
md = path.read_text(encoding='utf-8')
block = md[md.index('<!-- BEGIN GENERATED'):md.index('<!-- END GENERATED')]
want = [l for l in block.splitlines()
        if l.startswith('|') and not re.match(r'\|\s*-+\s*\|', l)]

out = subprocess.run(['gh', 'api', 'markdown', '--input', '-'],
                     input=json.dumps({'text': block, 'mode': 'gfm'}),
                     capture_output=True, text=True, check=True).stdout
rows = [r for t in re.findall(r'<table[^>]*>(.*?)</table>', out, re.S)
        for r in re.findall(r'<tr[^>]*>(.*?)</tr>', t, re.S)]
bad = [r for r in rows if len(re.findall(r'<t[dh][^>]*>', r)) != 3]

print(f'{path.name}: {len(want)} table rows written, {len(rows)} rendered as '
      f'rows, {len(bad)} with the wrong number of cells')
if len(rows) != len(want) or bad:
    for r in bad[:10]:
        print('  ', re.sub(r'\s+', ' ', r)[:120])
    sys.exit(1)
