# Title: Picked from kragen/xcompose
# Source: https://github.com/kragen/xcompose, file dotXCompose at commit
#   2131a4712910a0df23be46bdfae5ff812dd295a9 (2026-06-17).
# Licence: none stated (kragen/xcompose issue #16, open since 2015). Included
#   regardless, as a small, hand-picked subset.
# Selection: sequences/50-kragen.picks. Lowest priority but WinCompose.
# Imported by tools/gen-sequences.py: 65 sequences; skipped {'untypeable': 70, 'not Compose-prefixed': 0, 'modifiers': 0, 'unparsed': 0}

<Multi_key> <minus> <M> : "—"  # EM DASH
<Multi_key> <minus> <N> : "–"  # EN DASH
<Multi_key> <6> <apostrophe> : "‘"  # LEFT SINGLE QUOTATION MARK (high 6)
<Multi_key> <6> <quotedbl> : "“"  # LEFT DOUBLE QUOTATION MARK (66)
<Multi_key> <9> <apostrophe> : "’"  # RIGHT SINGLE QUOTATION MARK (high 9)
<Multi_key> <9> <quotedbl> : "”"  # RIGHT DOUBLE QUOTATION MARK (99)
<Multi_key> <i> <n> : "∈"  # ELEMENT OF
<Multi_key> <exclam> <i> <n> : "∉"  # NOT AN ELEMENT OF
<Multi_key> <c> <b> <r> <t> : "∛"  # CUBE ROOT
<Multi_key> <Multi_key> <asterisk> <o> : "∘"  # RING OPERATOR (function composition)
<Multi_key> <Multi_key> <asterisk> <period> : "⋅"  # DOT OPERATOR (dot product)
<Multi_key> <Multi_key> <a> <l> <e> <p> <h> : "ℵ"  # ALEF SYMBOL
<Multi_key> <Multi_key> <h> <b> <a> <r> : "ℏ"  # PLANCK CONSTANT OVER TWO PI
<Multi_key> <asterisk> <b> : "β"  # GREEK SMALL LETTER BETA
<Multi_key> <asterisk> <c> : "ψ"  # GREEK SMALL LETTER PSI
<Multi_key> <asterisk> <d> : "δ"  # GREEK SMALL LETTER DELTA
