# Title: From pointless-xcompose
# Source: https://github.com/rrthomas/pointless-xcompose, file `xcompose` at
#   commit e8c1edc2a21a56fe034ccc7954c4ff92aa288f30 (2025-09-26).
# Licence: public domain (the repository's doc/license.txt reads "Public domain.").
# Only Compose-prefixed sequences whose keys a US keyboard can type are kept.
# Lower priority than the original table, X11 and our additions: its 32
# deliberate overrides of X11 sequences (e.g. "<>" -> ↔) therefore do not apply.
# Imported by tools/gen-sequences.py: 574 sequences; skipped {'untypeable': 22, 'not Compose-prefixed': 0, 'modifiers': 0, 'unparsed': 0}

<Multi_key> <less> <greater> : "↔"  # INTENTIONAL CONFLICT
<Multi_key> <asciicircum> <bar> : "↑"
<Multi_key> <bar> <asciicircum> : "↑"
<Multi_key> <v> <bar> : "↓"
<Multi_key> <bar> <v> : "↓"
