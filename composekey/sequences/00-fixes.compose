# Title: Fixes: sequence cleanup (consistent key order, accents, Greek)
# Written for this extension. Takes priority over every other source.
# Rules and reasons: docs/finder-design.md, "Round three: cleaning up the table".

# Conflicting pairs: the accent now means the same in both orders (owner-accepted decisions). d- was the dong sign (still = d, d =); ,e was e-cedilla (by name); o+ was multiocular O; g' G' were g/G with hook (by name).
<Multi_key> <d> <minus> : "đ"  # LATIN SMALL LETTER D WITH STROKE
<Multi_key> <comma> <e> : "ę"  # LATIN SMALL LETTER E WITH OGONEK
<Multi_key> <comma> <E> : "Ę"  # LATIN CAPITAL LETTER E WITH OGONEK
<Multi_key> <o> <plus> : "ơ"  # LATIN SMALL LETTER O WITH HORN
<Multi_key> <g> <apostrophe> : "ǵ"  # LATIN SMALL LETTER G WITH ACUTE
<Multi_key> <G> <apostrophe> : "Ǵ"  # LATIN CAPITAL LETTER G WITH ACUTE

# Mirrors: a mark plus a letter giving that letter with the mark's accent works in both orders. Only where the reverse was unassigned and not the start of a longer sequence.
<Multi_key> <C> <asciicircum> : "Ĉ"  # LATIN CAPITAL LETTER C WITH CIRCUMFLEX
<Multi_key> <c> <asciicircum> : "ĉ"  # LATIN SMALL LETTER C WITH CIRCUMFLEX
<Multi_key> <G> <asciicircum> : "Ĝ"  # LATIN CAPITAL LETTER G WITH CIRCUMFLEX
<Multi_key> <g> <asciicircum> : "ĝ"  # LATIN SMALL LETTER G WITH CIRCUMFLEX
<Multi_key> <H> <asciicircum> : "Ĥ"  # LATIN CAPITAL LETTER H WITH CIRCUMFLEX
<Multi_key> <h> <asciicircum> : "ĥ"  # LATIN SMALL LETTER H WITH CIRCUMFLEX
<Multi_key> <J> <asciicircum> : "Ĵ"  # LATIN CAPITAL LETTER J WITH CIRCUMFLEX
<Multi_key> <j> <asciicircum> : "ĵ"  # LATIN SMALL LETTER J WITH CIRCUMFLEX
<Multi_key> <O> <equal> : "Ő"  # LATIN CAPITAL LETTER O WITH DOUBLE ACUTE
<Multi_key> <o> <equal> : "ő"  # LATIN SMALL LETTER O WITH DOUBLE ACUTE
<Multi_key> <S> <asciicircum> : "Ŝ"  # LATIN CAPITAL LETTER S WITH CIRCUMFLEX
<Multi_key> <s> <asciicircum> : "ŝ"  # LATIN SMALL LETTER S WITH CIRCUMFLEX
<Multi_key> <U> <equal> : "Ű"  # LATIN CAPITAL LETTER U WITH DOUBLE ACUTE
<Multi_key> <u> <equal> : "ű"  # LATIN SMALL LETTER U WITH DOUBLE ACUTE
<Multi_key> <O> <plus> : "Ơ"  # LATIN CAPITAL LETTER O WITH HORN
<Multi_key> <U> <plus> : "Ư"  # LATIN CAPITAL LETTER U WITH HORN
<Multi_key> <u> <plus> : "ư"  # LATIN SMALL LETTER U WITH HORN
<Multi_key> <N> <grave> : "Ǹ"  # LATIN CAPITAL LETTER N WITH GRAVE
<Multi_key> <n> <grave> : "ǹ"  # LATIN SMALL LETTER N WITH GRAVE
<Multi_key> <Y> <underscore> : "Ȳ"  # LATIN CAPITAL LETTER Y WITH MACRON
<Multi_key> <y> <underscore> : "ȳ"  # LATIN SMALL LETTER Y WITH MACRON
