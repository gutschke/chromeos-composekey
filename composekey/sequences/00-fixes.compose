<Multi_key> <u> <less> : "ǔ"  # LATIN SMALL LETTER U WITH CARON
<Multi_key> <less> <G> : "Ǧ"  # LATIN CAPITAL LETTER G WITH CARON
<Multi_key> <G> <less> : "Ǧ"  # LATIN CAPITAL LETTER G WITH CARON
<Multi_key> <less> <g> : "ǧ"  # LATIN SMALL LETTER G WITH CARON
<Multi_key> <g> <less> : "ǧ"  # LATIN SMALL LETTER G WITH CARON
<Multi_key> <less> <K> : "Ǩ"  # LATIN CAPITAL LETTER K WITH CARON
<Multi_key> <K> <less> : "Ǩ"  # LATIN CAPITAL LETTER K WITH CARON
<Multi_key> <less> <k> : "ǩ"  # LATIN SMALL LETTER K WITH CARON
<Multi_key> <k> <less> : "ǩ"  # LATIN SMALL LETTER K WITH CARON
<Multi_key> <less> <j> : "ǰ"  # LATIN SMALL LETTER J WITH CARON
<Multi_key> <j> <less> : "ǰ"  # LATIN SMALL LETTER J WITH CARON
