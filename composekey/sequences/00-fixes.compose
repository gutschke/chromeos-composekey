# Caron with <, both orders, for every caron letter (taught form; c and v prefixes stay as compatibility). Replaces < o (anticlockwise gapped circle arrow) and H < (heavy left angle ornament), both by name now.
<Multi_key> <less> <A> : "Ǎ"  # LATIN CAPITAL LETTER A WITH CARON
<Multi_key> <A> <less> : "Ǎ"  # LATIN CAPITAL LETTER A WITH CARON
<Multi_key> <less> <a> : "ǎ"  # LATIN SMALL LETTER A WITH CARON
<Multi_key> <a> <less> : "ǎ"  # LATIN SMALL LETTER A WITH CARON
<Multi_key> <less> <I> : "Ǐ"  # LATIN CAPITAL LETTER I WITH CARON
<Multi_key> <I> <less> : "Ǐ"  # LATIN CAPITAL LETTER I WITH CARON
<Multi_key> <less> <i> : "ǐ"  # LATIN SMALL LETTER I WITH CARON
<Multi_key> <i> <less> : "ǐ"  # LATIN SMALL LETTER I WITH CARON
<Multi_key> <less> <O> : "Ǒ"  # LATIN CAPITAL LETTER O WITH CARON
<Multi_key> <O> <less> : "Ǒ"  # LATIN CAPITAL LETTER O WITH CARON
<Multi_key> <less> <o> : "ǒ"  # LATIN SMALL LETTER O WITH CARON
<Multi_key> <o> <less> : "ǒ"  # LATIN SMALL LETTER O WITH CARON
