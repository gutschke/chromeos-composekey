# Breve: letter then (. "( x" stays with the circled letters, so breve is the one accent written after the letter only.
<Multi_key> <e> <parenleft> : "ĕ"  # LATIN SMALL LETTER E WITH BREVE
<Multi_key> <i> <parenleft> : "ĭ"  # LATIN SMALL LETTER I WITH BREVE
<Multi_key> <o> <parenleft> : "ŏ"  # LATIN SMALL LETTER O WITH BREVE
<Multi_key> <u> <parenleft> : "ŭ"  # LATIN SMALL LETTER U WITH BREVE
<Multi_key> <E> <parenleft> : "Ĕ"  # LATIN CAPITAL LETTER E WITH BREVE
<Multi_key> <I> <parenleft> : "Ĭ"  # LATIN CAPITAL LETTER I WITH BREVE
<Multi_key> <O> <parenleft> : "Ŏ"  # LATIN CAPITAL LETTER O WITH BREVE
<Multi_key> <U> <parenleft> : "Ŭ"  # LATIN CAPITAL LETTER U WITH BREVE

# Diaeresis with :, both orders, as a second mark beside ". Replaces o : and O : (Cyrillic binocular O, by name).
<Multi_key> <colon> <a> : "ä"  # LATIN SMALL LETTER A WITH DIAERESIS
<Multi_key> <a> <colon> : "ä"  # LATIN SMALL LETTER A WITH DIAERESIS
<Multi_key> <colon> <e> : "ë"  # LATIN SMALL LETTER E WITH DIAERESIS
<Multi_key> <e> <colon> : "ë"  # LATIN SMALL LETTER E WITH DIAERESIS
<Multi_key> <colon> <i> : "ï"  # LATIN SMALL LETTER I WITH DIAERESIS
<Multi_key> <i> <colon> : "ï"  # LATIN SMALL LETTER I WITH DIAERESIS
<Multi_key> <colon> <o> : "ö"  # LATIN SMALL LETTER O WITH DIAERESIS
<Multi_key> <o> <colon> : "ö"  # LATIN SMALL LETTER O WITH DIAERESIS
<Multi_key> <colon> <u> : "ü"  # LATIN SMALL LETTER U WITH DIAERESIS
<Multi_key> <u> <colon> : "ü"  # LATIN SMALL LETTER U WITH DIAERESIS
<Multi_key> <colon> <y> : "ÿ"  # LATIN SMALL LETTER Y WITH DIAERESIS
<Multi_key> <y> <colon> : "ÿ"  # LATIN SMALL LETTER Y WITH DIAERESIS
<Multi_key> <colon> <A> : "Ä"  # LATIN CAPITAL LETTER A WITH DIAERESIS
<Multi_key> <A> <colon> : "Ä"  # LATIN CAPITAL LETTER A WITH DIAERESIS
<Multi_key> <colon> <E> : "Ë"  # LATIN CAPITAL LETTER E WITH DIAERESIS
<Multi_key> <E> <colon> : "Ë"  # LATIN CAPITAL LETTER E WITH DIAERESIS
<Multi_key> <colon> <I> : "Ï"  # LATIN CAPITAL LETTER I WITH DIAERESIS
<Multi_key> <I> <colon> : "Ï"  # LATIN CAPITAL LETTER I WITH DIAERESIS
<Multi_key> <colon> <O> : "Ö"  # LATIN CAPITAL LETTER O WITH DIAERESIS
<Multi_key> <O> <colon> : "Ö"  # LATIN CAPITAL LETTER O WITH DIAERESIS
<Multi_key> <colon> <U> : "Ü"  # LATIN CAPITAL LETTER U WITH DIAERESIS
<Multi_key> <U> <colon> : "Ü"  # LATIN CAPITAL LETTER U WITH DIAERESIS
<Multi_key> <colon> <Y> : "Ÿ"  # LATIN CAPITAL LETTER Y WITH DIAERESIS
<Multi_key> <Y> <colon> : "Ÿ"  # LATIN CAPITAL LETTER Y WITH DIAERESIS

# Greek: * is the Greek prefix (Greek keyboard layout), never ring. Alpha, theta and chi had no key sequence; w gives omega as it looks. Ring keeps o a, a a, o u, u o. Final sigma and cross product by name.
<Multi_key> <asterisk> <a> : "α"  # GREEK SMALL LETTER ALPHA
<Multi_key> <asterisk> <A> : "Α"  # GREEK CAPITAL LETTER ALPHA
<Multi_key> <asterisk> <u> : "θ"  # GREEK SMALL LETTER THETA
<Multi_key> <asterisk> <U> : "Θ"  # GREEK CAPITAL LETTER THETA
<Multi_key> <asterisk> <x> : "χ"  # GREEK SMALL LETTER CHI
<Multi_key> <asterisk> <w> : "ω"  # GREEK SMALL LETTER OMEGA
<Multi_key> <asterisk> <W> : "Ω"  # GREEK CAPITAL LETTER OMEGA

# u o gives u with ring, the same as o u; the u-breve prefix is retired (u o was o with breve, a look-alike trap). Breve stays on U o and o (.
<Multi_key> <u> <o> : "ů"  # LATIN SMALL LETTER U WITH RING ABOVE

# Invisible format characters move from single Compose to Compose Compose names, so they cannot be typed by accident and do not collide with names.
<Multi_key> <Multi_key> <n> <b> <s> <p> : " "  # NO-BREAK SPACE
<Multi_key> <Multi_key> <w> <j> : "⁠"  # WORD JOINER
<Multi_key> <Multi_key> <l> <r> <m> : "‎"  # LEFT-TO-RIGHT MARK
<Multi_key> <Multi_key> <r> <l> <m> : "‏"  # RIGHT-TO-LEFT MARK
<Multi_key> <Multi_key> <l> <r> <e> : "‪"  # LEFT-TO-RIGHT EMBEDDING
<Multi_key> <Multi_key> <r> <l> <e> : "‫"  # RIGHT-TO-LEFT EMBEDDING
<Multi_key> <Multi_key> <p> <d> <f> : "‬"  # POP DIRECTIONAL FORMATTING
<Multi_key> <Multi_key> <l> <r> <o> : "‭"  # LEFT-TO-RIGHT OVERRIDE
<Multi_key> <Multi_key> <r> <l> <o> : "‮"  # RIGHT-TO-LEFT OVERRIDE
<Multi_key> <Multi_key> <s> <h> <y> : "­"  # SOFT HYPHEN
<Multi_key> <Multi_key> <z> <w> <j> : "‍"  # ZERO WIDTH JOINER


# ~ = is ≈, as programmers write "approximately" (~=) and as three of
# three usability testers guessed; ≅ (congruent), which ~ = gave in
# pointless-xcompose, moves to = ~ and keeps its names.
<Multi_key> <asciitilde> <equal> : "≈"  # ALMOST EQUAL TO
<Multi_key> <equal> <asciitilde> : "≅"  # APPROXIMATELY EQUAL TO (congruent)

# Subscript letters: _ _ and the letter (_ a is ā, the macron, so one _ is
# taken); _ _ * and the letter for Greek, as * is Greek elsewhere. Mirrors
# ^ _ for superscript letters. _ _ alone (¯) then waits one key.
<Multi_key> <underscore> <underscore> <a> : "ₐ"  # LATIN SUBSCRIPT SMALL LETTER A
<Multi_key> <underscore> <underscore> <e> : "ₑ"  # LATIN SUBSCRIPT SMALL LETTER E
<Multi_key> <underscore> <underscore> <o> : "ₒ"  # LATIN SUBSCRIPT SMALL LETTER O
<Multi_key> <underscore> <underscore> <x> : "ₓ"  # LATIN SUBSCRIPT SMALL LETTER X
<Multi_key> <underscore> <underscore> <h> : "ₕ"  # LATIN SUBSCRIPT SMALL LETTER H
<Multi_key> <underscore> <underscore> <k> : "ₖ"  # LATIN SUBSCRIPT SMALL LETTER K
<Multi_key> <underscore> <underscore> <l> : "ₗ"  # LATIN SUBSCRIPT SMALL LETTER L
<Multi_key> <underscore> <underscore> <m> : "ₘ"  # LATIN SUBSCRIPT SMALL LETTER M
<Multi_key> <underscore> <underscore> <n> : "ₙ"  # LATIN SUBSCRIPT SMALL LETTER N
<Multi_key> <underscore> <underscore> <p> : "ₚ"  # LATIN SUBSCRIPT SMALL LETTER P
<Multi_key> <underscore> <underscore> <s> : "ₛ"  # LATIN SUBSCRIPT SMALL LETTER S
<Multi_key> <underscore> <underscore> <t> : "ₜ"  # LATIN SUBSCRIPT SMALL LETTER T
<Multi_key> <underscore> <underscore> <i> : "ᵢ"  # LATIN SUBSCRIPT SMALL LETTER I
<Multi_key> <underscore> <underscore> <r> : "ᵣ"  # LATIN SUBSCRIPT SMALL LETTER R
<Multi_key> <underscore> <underscore> <u> : "ᵤ"  # LATIN SUBSCRIPT SMALL LETTER U
<Multi_key> <underscore> <underscore> <v> : "ᵥ"  # LATIN SUBSCRIPT SMALL LETTER V
<Multi_key> <underscore> <underscore> <j> : "ⱼ"  # LATIN SUBSCRIPT SMALL LETTER J
<Multi_key> <underscore> <underscore> <asterisk> <b> : "ᵦ"  # GREEK SUBSCRIPT SMALL LETTER BETA
<Multi_key> <underscore> <underscore> <asterisk> <g> : "ᵧ"  # GREEK SUBSCRIPT SMALL LETTER GAMMA
<Multi_key> <underscore> <underscore> <asterisk> <r> : "ᵨ"  # GREEK SUBSCRIPT SMALL LETTER RHO
<Multi_key> <underscore> <underscore> <asterisk> <f> : "ᵩ"  # GREEK SUBSCRIPT SMALL LETTER PHI
<Multi_key> <underscore> <underscore> <asterisk> <x> : "ᵪ"  # GREEK SUBSCRIPT SMALL LETTER CHI

# Superscript letters: ^ ^ and the letter, the counterpart of _ _ for
# subscripts (^ a is â, so one ^ is taken). ^ ^ i and ^ ^ n were there.
<Multi_key> <asciicircum> <asciicircum> <A> : "ᴬ"  # MODIFIER LETTER CAPITAL A
<Multi_key> <asciicircum> <asciicircum> <B> : "ᴮ"  # MODIFIER LETTER CAPITAL B
