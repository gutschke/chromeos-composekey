# Breve via b (X11 and the original table): letter-as-accent; b a, b e, b o... wait for names (bad, beer, book). Breve is U + letter or letter + (.
<Multi_key> <b> <A>  # breve via b; use U A or A ( (was LATIN CAPITAL LETTER A WITH BREVE)
<Multi_key> <b> <a>  # breve via b; use U a or a ( (was LATIN SMALL LETTER A WITH BREVE)
<Multi_key> <b> <E>  # breve via b; use U E or E ( (was LATIN CAPITAL LETTER E WITH BREVE)
<Multi_key> <b> <e>  # breve via b; use U e or e ( (was LATIN SMALL LETTER E WITH BREVE)
<Multi_key> <b> <G>  # breve via b; use U G or G ( (was LATIN CAPITAL LETTER G WITH BREVE)
<Multi_key> <b> <g>  # breve via b; use U g or g ( (was LATIN SMALL LETTER G WITH BREVE)
<Multi_key> <b> <I>  # breve via b; use U I or I ( (was LATIN CAPITAL LETTER I WITH BREVE)
<Multi_key> <b> <i>  # breve via b; use U i or i ( (was LATIN SMALL LETTER I WITH BREVE)
<Multi_key> <b> <O>  # breve via b; use U O or O ( (was LATIN CAPITAL LETTER O WITH BREVE)
<Multi_key> <b> <o>  # breve via b; use U o or o ( (was LATIN SMALL LETTER O WITH BREVE)
<Multi_key> <b> <U>  # breve via b; use U U or U ( (was LATIN CAPITAL LETTER U WITH BREVE)
<Multi_key> <b> <u>  # breve via b; use U u or u ( (was LATIN SMALL LETTER U WITH BREVE)

# _ _ is the subscript prefix now (00-fixes.compose); the bare macron ¯
# is typed by name (macron).
<Multi_key> <underscore> <underscore>  # was MACRON
