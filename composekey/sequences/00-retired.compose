# Retired: sequences removed from all sources (left-hand sides only).
# A sequence redefined in 00-fixes.compose is not listed here.

# u-breve prefix (X11): letter-as-accent, the source of the u o / o u trap. Breve is U + letter or letter + (.
<Multi_key> <u> <A>  # breve via u; use U A (was LATIN CAPITAL LETTER A WITH BREVE)
<Multi_key> <u> <a>  # breve via u; use U a (was LATIN SMALL LETTER A WITH BREVE)
<Multi_key> <u> <E>  # breve via u; use U E (was LATIN CAPITAL LETTER E WITH BREVE)
<Multi_key> <u> <e>  # breve via u; use U e (was LATIN SMALL LETTER E WITH BREVE)
<Multi_key> <u> <G>  # breve via u; use U G (was LATIN CAPITAL LETTER G WITH BREVE)
<Multi_key> <u> <g>  # breve via u; use U g (was LATIN SMALL LETTER G WITH BREVE)
<Multi_key> <u> <I>  # breve via u; use U I (was LATIN CAPITAL LETTER I WITH BREVE)
<Multi_key> <u> <i>  # breve via u; use U i (was LATIN SMALL LETTER I WITH BREVE)
<Multi_key> <u> <O>  # breve via u; use U O (was LATIN CAPITAL LETTER O WITH BREVE)
<Multi_key> <u> <U>  # breve via u; use U U (was LATIN CAPITAL LETTER U WITH BREVE)
<Multi_key> <u> <u>  # breve via u; use U u (was LATIN SMALL LETTER U WITH BREVE)

# Letter+letter sequences that are not genuine digraphs; reachable by name.
<Multi_key> <f> <i>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE FI)
<Multi_key> <f> <f>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE FF)
<Multi_key> <f> <l>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE FL)
<Multi_key> <F> <i>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE FFI)
<Multi_key> <F> <l>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE FFL)
<Multi_key> <s> <t>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE ST)
<Multi_key> <f> <t>  # presentation ligature; Unicode compatibility form, and fire became ﬁre (was LATIN SMALL LIGATURE LONG S T)
<Multi_key> <d> <i>  # diameter sign; collides with 18 names (was DIAMETER SIGN)
<Multi_key> <s> <c>  # duplicate section sign (s o, o s, s !) (was SECTION SIGN)
<Multi_key> <s> <m>  # duplicate service mark; SM stays (was SERVICE MARK)
<Multi_key> <s> <M>  # duplicate service mark; SM stays (was SERVICE MARK)
<Multi_key> <S> <m>  # duplicate service mark; SM stays (was SERVICE MARK)
<Multi_key> <s> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER ESH)
<Multi_key> <l> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER L WITH BELT)
<Multi_key> <p> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER PHI)
<Multi_key> <i> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN LETTER SMALL CAPITAL I)
<Multi_key> <u> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER UPSILON)
<Multi_key> <a> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER ALPHA)
<Multi_key> <e> <r>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER SCHWA WITH HOOK)
<Multi_key> <e> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER OPEN E)
<Multi_key> <r> <r>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER TURNED R)
<Multi_key> <r> <d>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER R WITH FISHHOOK)
<Multi_key> <g> <h>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER GAMMA)
<Multi_key> <g> <g>  # IPA from pointless; gg is a look-alike of g (was LATIN SMALL LETTER SCRIPT G)
<Multi_key> <k> <s>  # IPA from pointless; gg is a look-alike of g (was LATIN LETTER BILABIAL CLICK)
<Multi_key> <m> <m>  # math by name; ll turned l l a p into ℓap (was MINUS SIGN)
<Multi_key> <l> <l>  # math by name; ll turned l l a p into ℓap (was SCRIPT SMALL L)
<Multi_key> <s> <q>  # math by name; ll turned l l a p into ℓap (was SQUARE ROOT)
<Multi_key> <n> <i>  # math by name; ll turned l l a p into ℓap (was CONTAINS AS MEMBER)
<Multi_key> <i> <n>  # math by name; ll turned l l a p into ℓap (was ELEMENT OF)
<Multi_key> <b> <h>  # pictograph by name (was BIOHAZARD SIGN)
<Multi_key> <p> <c>  # pictograph by name (was PEACE SYMBOL)
<Multi_key> <f> <v>  # pictograph by name (was WHITE DOWN POINTING INDEX)
<Multi_key> <f> <w>  # pictograph by name (was WRITING HAND)
<Multi_key> <w> <w>  # wynn and yogh, historical (was LATIN LETTER WYNN)
<Multi_key> <W> <W>  # wynn and yogh, historical (was LATIN CAPITAL LETTER WYNN)
<Multi_key> <y> <y>  # wynn and yogh, historical (was LATIN SMALL LETTER YOGH)
<Multi_key> <Y> <Y>  # wynn and yogh, historical (was LATIN CAPITAL LETTER YOGH)
<Multi_key> <l> <t>  # X11 stand-in for a key a US keyboard has (was LESS-THAN SIGN)
<Multi_key> <g> <t>  # X11 stand-in for a key a US keyboard has (was GREATER-THAN SIGN)
<Multi_key> <L> <T>  # X11 stand-in for a key a US keyboard has (was LESS-THAN SIGN)
<Multi_key> <G> <T>  # X11 stand-in for a key a US keyboard has (was GREATER-THAN SIGN)
<Multi_key> <v> <l>  # X11 stand-in for a key a US keyboard has (was VERTICAL LINE)
<Multi_key> <l> <v>  # X11 stand-in for a key a US keyboard has (was VERTICAL LINE)
<Multi_key> <V> <L>  # X11 stand-in for a key a US keyboard has (was VERTICAL LINE)
<Multi_key> <L> <V>  # X11 stand-in for a key a US keyboard has (was VERTICAL LINE)

# Invisible and combining characters: never one key or a swap away from a visible sequence, never ending in Space.
<Multi_key> <minus> <minus> <space>  # soft hyphen ate the Space; Compose Compose shy (was SOFT HYPHEN)
<Multi_key> <quotedbl> <apostrophe>  # combining mark; name only (was COMBINING GREEK DIALYTIKA TONOS)
<Multi_key> <n> <b> <s> <p>  # Compose Compose nbsp (was NO-BREAK SPACE)
<Multi_key> <space> <W> <J>  # ZWJ, misnamed WJ; Compose Compose zwj (was ZERO WIDTH JOINER)
<Multi_key> <w> <j>  # word joiner; Compose Compose wj (was WORD JOINER)
<Multi_key> <l> <r> <m>  # Compose Compose lrm (was LEFT-TO-RIGHT MARK)
<Multi_key> <r> <l> <m>  # Compose Compose rlm (was RIGHT-TO-LEFT MARK)
<Multi_key> <l> <r> <e>  # Compose Compose lre (was LEFT-TO-RIGHT EMBEDDING)
<Multi_key> <r> <l> <e>  # Compose Compose rle (was RIGHT-TO-LEFT EMBEDDING)
<Multi_key> <p> <d> <f>  # Compose Compose pdf (was POP DIRECTIONAL FORMATTING)
<Multi_key> <l> <r> <o>  # bidi override; Compose Compose lro (was LEFT-TO-RIGHT OVERRIDE)
<Multi_key> <r> <l> <o>  # bidi override; Compose Compose rlo (was RIGHT-TO-LEFT OVERRIDE)
<Multi_key> <asciicircum> <greater>  # combining arrow; name only (was COMBINING RIGHT ARROW ABOVE)
<Multi_key> <bar> <underscore>  # combining mark; name only (was COMBINING VERTICAL LINE BELOW)
<Multi_key> <backslash> <underscore> <bar>  # combining mark; name only (was COMBINING VERTICAL LINE BELOW)

# Ring after *: * is the Greek prefix now, and a mark must mean the same in both orders. Ring: o a, a a, o u, u o.
<Multi_key> <a> <asterisk>  # ring via * (was LATIN SMALL LETTER A WITH RING ABOVE)
<Multi_key> <A> <asterisk>  # ring via * (was LATIN CAPITAL LETTER A WITH RING ABOVE)
<Multi_key> <u> <asterisk>  # ring via * (was LATIN SMALL LETTER U WITH RING ABOVE)
<Multi_key> <U> <asterisk>  # ring via * (was LATIN CAPITAL LETTER U WITH RING ABOVE)

# Leftover of the H < change: its pair H > alone would be the only such ornament.
<Multi_key> <H> <greater>  # heavy right angle ornament; by name (was HEAVY RIGHT-POINTING ANGLE QUOTATION MARK ORNAMENT)


# Letter sequences that are also the name of another character: typed after
# Compose, a name and a sequence of the same letters must mean one thing.
<Multi_key> <p> <i> <n> <t>  # name pint is 🍺 (was SEMICIRCULAR POLE INTEGRAL)
<Multi_key> <s> <w> <e> <a> <t>  # name sweat is 😅 (was SPLASHING SWEAT SYMBOL)

# Retired: letter-as-accent rows (caron via c and v, breve via b).
# Same format as 00-retired.compose. Ring via o (o a, o u, u o) is kept on purpose: it has no punctuation form.

# Caron via c (X11 and the original table): letter-as-accent; c a, c e, c h... wait for names (cake, cell, check). Caron is < before or after the letter.
<Multi_key> <c> <C>  # caron via c; use < C or C < (was LATIN CAPITAL LETTER C WITH CARON)
<Multi_key> <c> <c>  # caron via c; use < c or c < (was LATIN SMALL LETTER C WITH CARON)
<Multi_key> <c> <D>  # caron via c; use < D or D < (was LATIN CAPITAL LETTER D WITH CARON)
<Multi_key> <c> <d>  # caron via c; use < d or d < (was LATIN SMALL LETTER D WITH CARON)
<Multi_key> <c> <E>  # caron via c; use < E or E < (was LATIN CAPITAL LETTER E WITH CARON)
<Multi_key> <c> <e>  # caron via c; use < e or e < (was LATIN SMALL LETTER E WITH CARON)
<Multi_key> <c> <L>  # caron via c; use < L or L < (was LATIN CAPITAL LETTER L WITH CARON)
<Multi_key> <c> <l>  # caron via c; use < l or l < (was LATIN SMALL LETTER L WITH CARON)
<Multi_key> <c> <N>  # caron via c; use < N or N < (was LATIN CAPITAL LETTER N WITH CARON)
<Multi_key> <c> <n>  # caron via c; use < n or n < (was LATIN SMALL LETTER N WITH CARON)
<Multi_key> <c> <R>  # caron via c; use < R or R < (was LATIN CAPITAL LETTER R WITH CARON)
<Multi_key> <c> <r>  # caron via c; use < r or r < (was LATIN SMALL LETTER R WITH CARON)
<Multi_key> <c> <S>  # caron via c; use < S or S < (was LATIN CAPITAL LETTER S WITH CARON)
<Multi_key> <c> <s>  # caron via c; use < s or s < (was LATIN SMALL LETTER S WITH CARON)
<Multi_key> <c> <T>  # caron via c; use < T or T < (was LATIN CAPITAL LETTER T WITH CARON)
<Multi_key> <c> <t>  # caron via c; use < t or t < (was LATIN SMALL LETTER T WITH CARON)
<Multi_key> <c> <Z>  # caron via c; use < Z or Z < (was LATIN CAPITAL LETTER Z WITH CARON)
<Multi_key> <c> <z>  # caron via c; use < z or z < (was LATIN SMALL LETTER Z WITH CARON)
<Multi_key> <c> <A>  # caron via c; use < A or A < (was LATIN CAPITAL LETTER A WITH CARON)
<Multi_key> <c> <a>  # caron via c; use < a or a < (was LATIN SMALL LETTER A WITH CARON)
<Multi_key> <c> <I>  # caron via c; use < I or I < (was LATIN CAPITAL LETTER I WITH CARON)
<Multi_key> <c> <i>  # caron via c; use < i or i < (was LATIN SMALL LETTER I WITH CARON)
<Multi_key> <c> <O>  # caron via c; use < O or O < (was LATIN CAPITAL LETTER O WITH CARON)
<Multi_key> <c> <o>  # caron via c; use < o or o < (was LATIN SMALL LETTER O WITH CARON)
<Multi_key> <c> <U>  # caron via c; use < U or U < (was LATIN CAPITAL LETTER U WITH CARON)
<Multi_key> <c> <u>  # caron via c; use < u or u < (was LATIN SMALL LETTER U WITH CARON)
<Multi_key> <c> <G>  # caron via c; use < G or G < (was LATIN CAPITAL LETTER G WITH CARON)
<Multi_key> <c> <g>  # caron via c; use < g or g < (was LATIN SMALL LETTER G WITH CARON)
<Multi_key> <c> <K>  # caron via c; use < K or K < (was LATIN CAPITAL LETTER K WITH CARON)
<Multi_key> <c> <k>  # caron via c; use < k or k < (was LATIN SMALL LETTER K WITH CARON)
<Multi_key> <c> <j>  # caron via c; use < j or j < (was LATIN SMALL LETTER J WITH CARON)
